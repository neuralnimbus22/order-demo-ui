pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven-jdk21-chrome:local
    imagePullPolicy: IfNotPresent
    command: ["sleep"]
    args: ["9999999"]
    volumeMounts:
    - name: maven-cache
      mountPath: /m2repo
    resources:
      requests:
        memory: "2Gi"
        cpu: "500m"
  volumes:
  - name: maven-cache
    persistentVolumeClaim:
      claimName: maven-cache
"""
        }
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '10'))
    }
    parameters {
        string(name: 'Environment', defaultValue: 'test')
        string(name: 'BaseUrl', defaultValue: 'http://order-demo-ui.order-demo.svc.cluster.local:3000')
        string(name: 'TestCycleName', defaultValue: 'Order Demo UI BDD Automated Run')
    }
    triggers {
        cron "TZ=America/Toronto\nH H(0-7) * * 1-5"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Get Env variables') {
            steps {
                script {
                    echo "Resolving environment for ${params.Environment}"
                    env.E2E_BASE_URL = params.BaseUrl
                }
            }
        }
        stage('Build') {
            steps {
                container('maven') {
                    sh "mvn -f bdd/pom.xml -Dmaven.repo.local=/m2repo clean verify -Dui.base.url=${params.BaseUrl} -Denv=${params.Environment}"
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'bdd/target/surefire-reports/*.xml', allowEmptyArchive: true
        }
    }
}
